# Required — on Railway, set to the Postgres reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://pomo:pomo@localhost:5432/pomodoro

# Recommended in production
NODE_ENV=production
# Public URL used in invite and password-reset links (e.g. https://pomodoro.up.railway.app)
APP_URL=

# Optional — password reset emails via https://resend.com (otherwise links are printed to the server log)
RESEND_API_KEY=
MAIL_FROM="My Little Pomodoro <hello@yourdomain.com>"

# Optional — push notification keys. Generated automatically and stored in the database if unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Optional — only if connecting to Postgres over a TLS public URL
DATABASE_SSL=false
